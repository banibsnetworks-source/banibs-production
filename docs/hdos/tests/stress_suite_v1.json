{
  "suite_id": "stress_suite_v1",
  "version": "1.0.0",
  "created": "2026-02-10",
  "description": "HDOS Stress Test Suite - Core attack vectors for human defense validation",
  "pass_threshold": "ALL_GREEN",
  "tests": [
    {
      "id": "ST-001",
      "name": "Abuse Shield Attack",
      "amendment": "A-0001",
      "axioms": ["Axiom 7: Community Protection"],
      "category": "safety",
      "severity": "critical",
      "description": "Test resistance to coordinated abuse, harassment, and brigading attacks",
      "attack_vectors": [
        "Mass reporting to silence legitimate users",
        "Coordinated harassment campaigns",
        "Sock puppet amplification",
        "Targeted doxxing attempts",
        "Community infiltration by bad actors"
      ],
      "pass_criteria": [
        "Abuse detection triggers within threshold",
        "Victim protection activates before significant harm",
        "False positive rate below 1%",
        "Appeals process accessible and timely",
        "Attacker patterns logged for review"
      ],
      "fail_indicators": [
        "Legitimate users silenced by mass reports",
        "Harassment persists without intervention",
        "Victims must self-advocate repeatedly",
        "Abusers face no meaningful consequences"
      ]
    },
    {
      "id": "ST-002",
      "name": "Emergency Urgency Attack",
      "amendment": "A-0002",
      "axioms": ["Axiom 2: Time Sovereignty", "Axiom 5: Calm Technology"],
      "category": "manipulation",
      "severity": "high",
      "description": "Test resistance to artificial urgency and FOMO manipulation tactics",
      "attack_vectors": [
        "Fake countdown timers",
        "Limited availability lies",
        "Loss aversion triggers",
        "Social proof manipulation",
        "Notification bombardment"
      ],
      "pass_criteria": [
        "No artificial urgency in UI copy",
        "No fake scarcity indicators",
        "Notifications respect user preferences",
        "Clear opt-out for all alerts",
        "No guilt-based retention tactics"
      ],
      "fail_indicators": [
        "Countdown timers that reset",
        "'Only X left' when false",
        "Push notifications ignore settings",
        "Shame language on unsubscribe",
        "Hidden 'cancel' buttons"
      ]
    },
    {
      "id": "ST-003",
      "name": "Infinite Analysis Loop",
      "amendment": "A-0003",
      "axioms": ["Axiom 1: Human Agency First", "Axiom 3: Transparency Mandate"],
      "category": "ai_safety",
      "severity": "high",
      "description": "Test that AI systems have circuit breakers and don't trap users in loops",
      "attack_vectors": [
        "Recursive clarification requests",
        "Endless 'more information needed'",
        "Analysis paralysis induction",
        "Decision deferral loops",
        "Confidence threshold gaming"
      ],
      "pass_criteria": [
        "AI interactions have clear endpoints",
        "Maximum iteration limits enforced",
        "User can exit any AI flow immediately",
        "Partial results provided when stuck",
        "Clear escalation to human support"
      ],
      "fail_indicators": [
        "No way to exit AI conversation",
        "Repeated identical questions",
        "User forced to provide more data",
        "No timeout on AI processes",
        "AI blocks human override"
      ]
    },
    {
      "id": "ST-004",
      "name": "Power Asymmetry Blind Spot",
      "amendment": "A-0004",
      "axioms": ["Axiom 4: Power Balance", "Axiom 6: Exit Rights"],
      "category": "governance",
      "severity": "critical",
      "description": "Test that platform power is not used to exploit users",
      "attack_vectors": [
        "Admin abuse of privileges",
        "Data hostage situations",
        "Arbitrary account actions",
        "Appeal process obstruction",
        "Terms of service weaponization"
      ],
      "pass_criteria": [
        "All admin actions logged and auditable",
        "Users can export all their data",
        "Account actions require documented reason",
        "Appeals reviewed by different admin",
        "ToS changes notified 30+ days ahead"
      ],
      "fail_indicators": [
        "Shadow bans without disclosure",
        "Data export blocked or incomplete",
        "No reason given for account action",
        "Same admin handles appeal",
        "Retroactive ToS enforcement"
      ]
    },
    {
      "id": "ST-005",
      "name": "Attention Hijacking Attack",
      "amendment": null,
      "axioms": ["Axiom 2: Time Sovereignty", "Axiom 5: Calm Technology"],
      "category": "manipulation",
      "severity": "high",
      "description": "Test resistance to infinite scroll, autoplay, and attention-capturing dark patterns",
      "attack_vectors": [
        "Infinite scroll without natural stopping points",
        "Autoplay video/audio without consent",
        "Intermittent variable rewards (slot machine patterns)",
        "Pull-to-refresh dopamine loops",
        "Red notification badges that never clear"
      ],
      "pass_criteria": [
        "Content has natural pagination or endpoints",
        "Autoplay disabled by default",
        "Notification badges clear when viewed",
        "No variable reward gambling mechanics",
        "Session time reminders available"
      ],
      "fail_indicators": [
        "Endless scroll with no stopping cues",
        "Videos autoplay with sound",
        "Badges persist after viewing",
        "Feed algorithm optimizes for time-on-site",
        "No way to see session duration"
      ]
    },
    {
      "id": "ST-006",
      "name": "Dark Pattern Gauntlet",
      "amendment": null,
      "axioms": ["Axiom 1: Human Agency First", "Axiom 3: Transparency Mandate"],
      "category": "ux_integrity",
      "severity": "critical",
      "description": "Test for presence of deceptive UI patterns that trick users",
      "attack_vectors": [
        "Confirm-shaming (guilt for declining)",
        "Trick questions (double negatives)",
        "Hidden costs revealed late",
        "Forced continuity (hard to cancel)",
        "Misdirection (visual hierarchy manipulation)"
      ],
      "pass_criteria": [
        "All options presented neutrally",
        "Questions use clear, direct language",
        "All costs visible upfront",
        "Cancel is as easy as signup",
        "Primary actions clearly indicated"
      ],
      "fail_indicators": [
        "'No thanks, I don't want to save money'",
        "Confusing opt-in/opt-out toggles",
        "Fees appear only at checkout",
        "Cancel buried in settings maze",
        "Destructive actions styled as primary"
      ]
    },
    {
      "id": "ST-007",
      "name": "Data Exploitation Probe",
      "amendment": null,
      "axioms": ["Axiom 3: Transparency Mandate", "Axiom 6: Exit Rights"],
      "category": "privacy",
      "severity": "critical",
      "description": "Test for unauthorized data collection, sharing, or retention",
      "attack_vectors": [
        "Collecting data beyond stated purpose",
        "Sharing data with undisclosed third parties",
        "Retaining data after deletion request",
        "Tracking across sessions without consent",
        "Inferring sensitive attributes from behavior"
      ],
      "pass_criteria": [
        "Data collection matches privacy policy",
        "All third-party sharing disclosed",
        "Deletion requests honored within 30 days",
        "Tracking requires explicit opt-in",
        "No sensitive inference without consent"
      ],
      "fail_indicators": [
        "Hidden analytics or trackers",
        "Data sold to undisclosed parties",
        "Deleted data still accessible",
        "Cross-session tracking by default",
        "Profiling without user knowledge"
      ]
    },
    {
      "id": "ST-008",
      "name": "Vulnerable User Exploitation",
      "amendment": null,
      "axioms": ["Axiom 7: Community Protection", "Axiom 4: Power Balance"],
      "category": "safety",
      "severity": "critical",
      "description": "Test protection of minors, elderly, and vulnerable populations",
      "attack_vectors": [
        "Age-inappropriate content exposure",
        "Predatory targeting of elderly users",
        "Exploitation of cognitive vulnerabilities",
        "Financial manipulation of at-risk users",
        "Addiction-prone feature targeting"
      ],
      "pass_criteria": [
        "Age verification for sensitive content",
        "Enhanced protections for flagged accounts",
        "No predatory financial features",
        "Addiction warning systems active",
        "Guardian/family controls available"
      ],
      "fail_indicators": [
        "Minors exposed to adult content",
        "Elderly users targeted for purchases",
        "No spending limits or warnings",
        "Addiction patterns undetected",
        "No parental oversight tools"
      ]
    },
    {
      "id": "ST-009",
      "name": "Algorithmic Manipulation Test",
      "amendment": null,
      "axioms": ["Axiom 1: Human Agency First", "Axiom 3: Transparency Mandate"],
      "category": "ai_safety",
      "severity": "high",
      "description": "Test that algorithms serve users, not engagement metrics",
      "attack_vectors": [
        "Outrage amplification for engagement",
        "Filter bubbles and echo chambers",
        "Recommendation rabbit holes",
        "Emotional state exploitation",
        "Controversy prioritization"
      ],
      "pass_criteria": [
        "Diverse viewpoints in recommendations",
        "User control over algorithm behavior",
        "No optimization for negative emotions",
        "Transparent recommendation reasons",
        "Easy algorithm reset/retrain option"
      ],
      "fail_indicators": [
        "Outrage content consistently promoted",
        "No viewpoint diversity in feed",
        "Users can't adjust recommendations",
        "Algorithm behavior unexplainable",
        "Negative content drives engagement"
      ]
    },
    {
      "id": "ST-010",
      "name": "Exit Friction Assault",
      "amendment": null,
      "axioms": ["Axiom 6: Exit Rights", "Axiom 4: Power Balance"],
      "category": "governance",
      "severity": "high",
      "description": "Test that users can leave the platform without obstruction",
      "attack_vectors": [
        "Account deletion hidden or complex",
        "Data export intentionally slow/broken",
        "Social graph held hostage",
        "Reactivation dark patterns",
        "Incomplete deletion (data retained)"
      ],
      "pass_criteria": [
        "Account deletion in 3 clicks or less",
        "Full data export within 48 hours",
        "Contact export in standard format",
        "No guilt/shame on exit screens",
        "Deletion is complete and verifiable"
      ],
      "fail_indicators": [
        "Deletion requires support ticket",
        "Export takes weeks or fails",
        "Cannot export contact list",
        "'Are you sure?' repeated multiple times",
        "Account 'deactivated' but data kept"
      ]
    }
  ],
  "execution_notes": {
    "environment": "Production-equivalent or staging",
    "frequency": "Before every major release",
    "documentation": "All runs recorded in /docs/hdos/runs/",
    "escalation": "Any FAIL blocks release until resolved"
  }
}
